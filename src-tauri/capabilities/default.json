{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主視窗：只開放用到的事件和指令",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-list-instruments",
    "allow-get-candles",
    "allow-set-streams",
    "allow-alert-notify",
    "allow-store-load",
    "allow-store-set",
    "allow-store-remove",
    "allow-gpu-pref",
    "allow-set-gpu-pref",
    "allow-open-tradingview"
  ]
}
