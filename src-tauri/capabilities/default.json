{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主視窗：只開放用到的事件和指令",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-list-instruments",
    "allow-get-candles",
    "allow-set-streams",
    "allow-alert-notify",
    "allow-store-load",
    "allow-store-set",
    "allow-store-remove",
    "allow-trade-status",
    "allow-trade-set-keys",
    "allow-trade-unlock",
    "allow-trade-lock",
    "allow-trade-set-password",
    "allow-trade-clear-keys",
    "allow-trade-account",
    "allow-trade-place",
    "allow-trade-order",
    "allow-trade-cancel",
    "allow-trade-sync",
    "allow-trade-closed-positions",
    "allow-trade-amend-stops",
    "allow-gpu-pref",
    "allow-set-gpu-pref",
    "allow-open-tradingview"
  ]
}
